{
  "name": "free-ai-assistant",
  "displayName": "Free AI Assistant",
  "description": "Cérebro de IA integrado com Failover (Gemini + Ollama) e Claude Code System Prompt",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "meu-copilot.perguntar",
        "title": "Cérebro IA: Fazer Pergunta/Solicitação"
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "compile": "tsc -p ./",
    "check": "npm run typecheck && npm run compile"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.125.0",
    "typescript": "^7.0.2"
  }
}
